# Test environment for pychrony with libchrony and chronyd
# Multi-stage build: builder stage compiles libchrony, runtime stage runs tests
#
# PYCHRONY_INSTALL selects what gets tested:
#   source (default)  build and install pychrony from this source tree
#   wheel             install a prebuilt wheel instead, e.g. from cibuildwheel:
#     docker build -t pychrony-test -f docker/Dockerfile.test \
#       --build-arg PYCHRONY_INSTALL=wheel --build-context wheelhouse=wheelhouse/ .
#   The wheelhouse must hold a wheel for this image's python3 (Fedora 44's).
ARG PYCHRONY_INSTALL=source

# Pinned uv, copied into the runtime image below. A FROM line (rather than a
# pip install) lets Dependabot's docker ecosystem bump it.
FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

# =============================================================================
# Stage 1: Builder - compile libchrony from vendored source
# =============================================================================
FROM fedora:44 AS builder

# Install build tools only
RUN dnf install -y \
    gcc \
    make \
    libtool \
    && dnf clean all

# Copy vendored libchrony source and build
COPY vendor/libchrony/ /tmp/libchrony/
WORKDIR /tmp/libchrony
RUN make && \
    make install prefix=/usr/local DESTDIR=/libchrony-install

# =============================================================================
# Placeholder wheelhouse; replaced by --build-context wheelhouse=<dir> when
# testing a wheel. Unused (and skipped) for source installs.
# =============================================================================
FROM scratch AS wheelhouse
# The marker is what makes "no wheelhouse given" detectable, and it must stay:
# BuildKit treats a COPY from an empty stage as a cache hit for the last
# wheelhouse COPY, so a build that forgot --build-context would silently
# reinstall whatever wheel an earlier build used.
COPY <<EOF /NO_WHEELHOUSE
EOF

# =============================================================================
# Stage 2: Runtime - minimal image with chrony and Python
# =============================================================================
FROM fedora:44 AS runtime

# Install runtime dependencies
# Note: gcc is needed to compile CFFI bindings for source installs
RUN dnf install -y \
    chrony \
    python3 \
    python3-devel \
    libffi-devel \
    gcc \
    && dnf clean all

# Copy compiled libchrony from builder
COPY --from=builder /libchrony-install/usr/local/ /usr/local/
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf && ldconfig

# Create chrony socket directory with correct permissions
RUN mkdir -p /run/chrony && chown chrony:chrony /run/chrony && chmod 750 /run/chrony

# Configure chronyd for testing (local reference clock + Unix socket + NTP source)
# The command port stays at its default (323 on localhost) so the auto-detect
# fallback from the Unix socket can be exercised; "cmdport 0" would make that
# path untestable.
# Fedora's stock "pool" line is removed so the only NTP source is the single
# "server" below. A pool starts as 8 placeholders that need several DNS
# answers to fill, and chronyd waits 28s before retrying a partial fill,
# which outlasts the CI readiness gate.
RUN sed -i '/^pool /d' /etc/chrony.conf && \
    echo "local stratum 10" >> /etc/chrony.conf && \
    echo "allow 127.0.0.1" >> /etc/chrony.conf && \
    echo "cmdallow 127.0.0.1" >> /etc/chrony.conf && \
    echo "bindcmdaddress /run/chrony/chronyd.sock" >> /etc/chrony.conf && \
    echo "server pool.ntp.org iburst" >> /etc/chrony.conf

# Unprivileged user for tests that must not be able to reach the Unix socket
RUN useradd -m testuser

# The test environment itself comes from uv.lock
COPY --from=uv /uv /uvx /usr/local/bin/

# Everything goes into one venv built with Fedora's python3. It is first on
# PATH, so `pytest` and `python3` (and sys.executable in tests) resolve to it.
ENV VIRTUAL_ENV=/opt/venv \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

# Install the locked runtime and test dependencies, but not pychrony itself.
# This layer is cached until pyproject.toml or uv.lock change.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --group dev

# =============================================================================
# Stage 3a: install pychrony from the source tree (default)
# =============================================================================
FROM runtime AS install-source

COPY setup.py README.md LICENSE ./
COPY LICENSES/ LICENSES/
COPY src/ src/

# Non-editable build through setup.py, which compiles the CFFI extension
# against the libchrony installed above when PYCHRONY_BUILD_CFFI=1. The
# package then lives only in site-packages, so tests never import from src/.
RUN PYCHRONY_BUILD_CFFI=1 uv sync --frozen --no-editable --group dev

# =============================================================================
# Stage 3b: install pychrony from a prebuilt wheel
# =============================================================================
FROM runtime AS install-wheel

# Install the wheel matching this image's python3 from the wheelhouse build
# context. No source tree is copied, so the wheel is the only pychrony there
# is. Dependencies are already installed from uv.lock, hence --no-deps.
# --python: uv pip would otherwise install into UV_PYTHON, outside the venv.
COPY --from=wheelhouse / /wheelhouse/
RUN if [ -e /wheelhouse/NO_WHEELHOUSE ] || ! ls /wheelhouse/*.whl >/dev/null 2>&1; then \
        echo "No wheels in the wheelhouse build context. Build with" \
             "--build-arg PYCHRONY_INSTALL=wheel --build-context wheelhouse=<dir>" >&2; \
        exit 1; \
    fi && \
    uv pip install --python "$VIRTUAL_ENV/bin/python" \
        --no-deps --no-index --only-binary :all: --prerelease allow \
        --find-links /wheelhouse pychrony && \
    rm -rf /wheelhouse && \
    python -c "import pychrony._core._cffi_bindings"

# =============================================================================
# Final stage: whichever install PYCHRONY_INSTALL selected, plus the tests
# =============================================================================
FROM install-${PYCHRONY_INSTALL}

COPY tests/ tests/
COPY --chmod=755 docker/run-integration.sh /usr/local/bin/run-integration.sh

# Integration tests must fail, not skip, if the compiled bindings are missing:
# this image exists to prove they work, so a skipped run must not look green.
ENV PYCHRONY_INTEGRATION_STRICT=1

# Default command: run all tests
CMD ["pytest", "tests/", "-v"]
